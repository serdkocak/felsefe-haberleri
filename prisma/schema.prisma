// Prisma şeması — Felsefe Haberleri
//
// Site, çağdaş filozofların konuşmalarını, açıklamalarını, fikirlerini ve yeni
// kitaplarını izleyen bir haber sitesidir. Bu yüzden model yalnızca "haber" değil,
// haberin kimin hakkında olduğunu (Philosopher) ve hangi kitabı konu aldığını (Book)
// da tutar. Mobil uygulama bu ilişkileri doğrudan API'den okur.
//
// Veritabanı: PostgreSQL (yerelde de üretimde de aynı — Neon).
//   DATABASE_URL : havuzlanmış (pooled) bağlantı — uygulama sorguları için.
//   DIRECT_URL   : doğrudan bağlantı — yalnızca `prisma migrate` kullanır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Haberi yazan editör.
model Author {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  @@map("authors")
}

/// Haberin bölümü: Gündem, Filozoflar, Türkiye, Dünya, Kitap ...
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  /// Menüdeki sıralama; küçük değer önce gelir.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@map("categories")
}

/// Serbest etiket: kavramlar, kurumlar, olaylar (yapay zekâ, ödül, arkeoloji ...).
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[] @relation("PostToTag")

  @@map("tags")
}

/// Haberin öznesi olan filozof. Sitenin ana izleme birimi budur:
/// okur bir filozofu takip eder, onunla ilgili tüm haberleri tek sayfada görür.
model Philosopher {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  /// Kısa tanıtım: "Siyaset felsefecisi, Harvard Üniversitesi".
  headline    String?
  bio         String?
  avatar      String?
  /// Ülke adı (ör. "ABD", "Almanya", "Türkiye").
  country     String?
  birthYear   Int?
  /// Bağlı olduğu kurum/üniversite.
  affiliation String?
  /// Kişisel ya da kurumsal sayfa.
  website     String?
  /// Ana sayfadaki "Takipteki Filozoflar" şeridinde gösterilir.
  featured    Boolean  @default(false)
  /// ONAY LİSTESİ. Filozof Dizini'nde ve "Takipteki Filozoflar" şeridinde
  /// yalnızca `listed = true` olan isimler görünür. Varsayılan `false`'tur:
  /// hiçbir isim, açıkça onaylanmadan dizine giremez (bkz. EDITORYAL.md).
  /// Listeden çıkarılan filozofun kaydı silinmez; yalnızca gizlenir.
  listed      Boolean  @default(false)

  /* --- Filozof Dizini alanları (ansiklopedik) ------------------------
     Tarihler String tutulur: bazı kaynaklarda yalnızca yıl bilinir
     ("MÖ 470 civarı", "1953"). Listeler satır satır yazılır; böylece
     veritabanına özgü dizi tipine bağımlı kalınmaz.                   */

  /// Tam adı (varsa göbek adları dâhil).
  fullName     String?
  /// "1953", "MÖ 470 civarı" gibi serbest biçim.
  birthDate    String?
  /// Yaşayan filozoflarda boş bırakılır.
  deathDate    String?
  /// Yaşayan filozofları ayırt etmek için.
  alive        Boolean @default(true)
  /// "Çağdaş", "20. yüzyıl", "Antik Yunan" gibi.
  period       String?
  /// Felsefe akımı: "Analitik felsefe", "Varoluşçuluk" ...
  school       String?
  /// Ana çalışma alanları — virgülle ayrılır.
  areas        String?
  /// Önemli eserleri — her satırda bir eser.
  majorWorks   String?
  /// Temel kavramları — virgülle ayrılır.
  keyConcepts  String?
  /// Etkilendiği filozoflar — virgülle ayrılır.
  influencedBy String?
  /// Etkilediği filozoflar — virgülle ayrılır.
  influenced   String?
  /// Ayrıntılı biyografi (Markdown).
  longBio      String?
  /// Kaynaklar — her satırda "Başlık — URL".
  sources      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[] @relation("PostToPhilosopher")
  books Book[]

  @@map("philosophers")
}

/// Yeni çıkan kitap. Bir filozofa ve isteğe bağlı olarak bir habere bağlanır.
model Book {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  /// Orijinal dildeki adı (çeviri kitaplar için).
  originalTitle String?
  publisher     String?
  /// Çeviri ise çevirmen adı.
  translator    String?
  language      String?
  isbn          String?
  coverImage    String?
  description   String?
  /// Yalnızca yıl biliniyorsa `year` kullanılır.
  year          Int?
  /** İlk baskının (eserin yazıldığı/ilk yayımlandığı) yılı; çeviri ve yeni baskılarda `year`dan farklıdır. */
  originalYear  Int?
  /// Yayıncı sayfası ya da kaynak bağlantısı.
  link          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  philosopherId String?
  philosopher   Philosopher? @relation(fields: [philosopherId], references: [id], onDelete: SetNull)

  /// Kitabı duyuran haber.
  postId String? @unique
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([philosopherId])
  @@map("books")
}

/// Haber. `content` alanı Markdown tutar.
model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String
  content     String
  coverImage  String?
  /// Görselin telif bilgisi ("Fotoğraf: ...").
  imageCredit String?
  /// Ana sayfada manşete çıkar.
  featured    Boolean   @default(false)
  /// Haberin dayandığı asıl kaynağın adı (ör. "Philosophy Now").
  sourceName  String?
  /// Kaynağın adresi. Haber sitesinde şeffaflık için zorunlu sayılmalıdır.
  sourceUrl   String?
  /// SEO başlığı — boşsa `title` kullanılır.
  seoTitle        String?
  /// Arama sonuçlarında görünen açıklama — boşsa `summary` kullanılır.
  metaDescription String?
  /// İçerik türü: HABER | ANALIZ | PORTRE | KITAP | ROPORTAJ | ETKINLIK | TARIH | KAVRAM
  /// Haber ile kalıcı (evergreen) içeriği ayırmak için.
  contentType String @default("HABER")

  /// null ise taslaktır; hiçbir genel uçta görünmez.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags         Tag[]         @relation("PostToTag")
  philosophers Philosopher[] @relation("PostToPhilosopher")
  book         Book?
  comments     Comment[]
  sources      PostSource[]

  @@index([publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("posts")
}


/// Okur yorumu. Üyelik zorunlu değildir: ad ve e-posta boş bırakılabilir,
/// yorum "Anonim" olarak yayımlanır. E-posta verilirse yalnızca yönetim görür.
model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// Boşsa arayüzde "Anonim" gösterilir.
  authorName  String?
  /// Yayımlanmaz; yalnızca moderasyon ve bildirim için saklanır.
  authorEmail String?
  body        String

  /// PENDING | APPROVED | REJECTED  (enum yerine String: SQLite/Postgres uyumu)
  status String @default("APPROVED")

  /// Yanıt zinciri için üst yorum.
  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  /// Kötüye kullanım incelemesi için; ham IP değil, tuzlanmış özet saklanır.
  ipHash    String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, status, createdAt])
  @@map("comments")
}

/// Bülten üyesi. Çift onaylı (double opt-in) kayıt:
/// kayıt olan kişiye onay bağlantısı gider, tıklamadan ACTIVE olmaz.
model Subscriber {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  /// PENDING | ACTIVE | UNSUBSCRIBED
  status String @default("PENDING")

  /// Onay ve çıkış bağlantılarındaki tek kullanımlık anahtarlar.
  confirmToken     String?   @unique
  unsubscribeToken String    @unique
  confirmedAt      DateTime?

  /// Bildirim gönderiminde tekrarları önlemek için son bildirim zamanı.
  lastNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("subscribers")
}

/// İletişim formundan gelen mesaj. Aynı zamanda e-posta olarak da iletilir;
/// e-posta gönderimi başarısız olsa bile mesaj burada kaybolmaz.
model Message {
  id      String  @id @default(cuid())
  name    String
  email   String
  subject String?
  body    String

  /// NEW | READ | ARCHIVED
  status String @default("NEW")

  ipHash    String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("messages")
}


/// Haberin dayandığı kaynaklar. Bir haberin birden çok kaynağı olabilir;
/// aynı olayı farklı yayınlar duyurduğunda hepsi tek haberde listelenir (6. kural).
model PostSource {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  title     String
  publisher String?
  /// Yayın tarihi — serbest biçim ("12 Ağustos 2026").
  date      String?
  url       String
  /// Birincil kaynak mı? Künyede önce gösterilir.
  primary   Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("post_sources")
}

/// Konferans, sempozyum, seminer, webinar, çalıştay, CFP ...
/// "Konferanslar" bölümü bu tablo üzerinden bir etkinlik takvimi gibi çalışır.
model Event {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  summary String?
  /// Ayrıntılı açıklama (Markdown).
  description String?

  /// KONFERANS | KONGRE | SEMPOZYUM | CALISTAY | SEMINER | WEBINAR | PANEL |
  /// DERS | KOLOKYUM | YAZ_OKULU | KIS_OKULU | CFP
  kind String @default("KONFERANS")

  /// Konuşmacılar — virgülle ayrılır.
  speakers  String?
  /// Düzenleyen kurum.
  organizer String?
  /// Konu başlığı / tema.
  topic     String?

  /// ONLINE | FIZIKSEL | HIBRIT
  format String @default("FIZIKSEL")

  startsAt DateTime
  endsAt   DateTime?
  /// "Europe/Istanbul" gibi; saat bilgisi verildiğinde anlam kazanır.
  timezone String?
  /// Saat bilgisi kaynakta yoksa false; arayüzde yalnızca tarih gösterilir.
  hasTime  Boolean @default(false)

  city    String?
  country String?
  venue   String?

  registrationUrl String?
  /// "Ücretsiz", "50 EUR" gibi serbest biçim.
  fee             String?
  /// Kayıt son tarihi.
  deadline        DateTime?
  /// Bildiri çağrısı son tarihi.
  cfpDeadline     DateTime?
  website         String?

  sourceName String?
  sourceUrl  String?
  coverImage String?

  featured    Boolean   @default(false)
  /// null ise taslak; listelerde görünmez.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([publishedAt])
  @@map("events")
}
